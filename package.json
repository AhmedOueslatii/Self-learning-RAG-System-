{
	"name": "rag-reflection-system",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:staging": "wrangler deploy --env staging",
		"dev": "wrangler dev",
		"dev:staging": "wrangler dev --env staging",
		"start": "wrangler dev",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit",
		"migrate": "wrangler d1 migrations apply rag-db --remote",
		"migrate:staging": "wrangler d1 migrations apply rag-db-staging --remote",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@types/node": "^26.4.1",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "^4.129.0"
	}
}